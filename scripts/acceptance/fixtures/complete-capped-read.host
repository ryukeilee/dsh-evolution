// Candidate source submitted through the real kernel by the capped-read
// acceptance. It is not installed by this repository: the Trial mounts it, the
// promotion gate decides, and the evidence records whether it ran.
//
// The official `read` tool stops a window at its byte cap and tells the model to
// continue with `offset`. When the remaining tail is small, that continuation is
// a whole extra model turn and tool call for content the model is about to read
// anyway. This policy appends that bounded tail to the existing result through
// the official `tools/post-execute` waterfall; it registers no tool, so the
// model does not have to choose it.
const MAX_FILE_BYTES = 256 * 1024;
const MAX_TAIL_LINES = 200;
const MAX_TAIL_BYTES = 16 * 1024;
// The host's default single-line truncation for the supported versions. A
// tail line longer than this would bypass the renderer's own per-line cap, so
// the policy declines instead of appending it.
const DEFAULT_LINE_CHARS = 2000;
// The dynamic-package host half runs in a `node:vm` sandbox where `Buffer` and
// `process` are absent (the sandbox provides TextEncoder instead). Using Buffer
// here made the hook throw and silently return the unmodified result, which is
// exactly what the Trial functional check caught.
const encoder = new TextEncoder();
// The official renderer's exact cap footer. Different host paths hand the
// waterfall either the raw rendered text or the same text inside the
// `<path>/<content>` envelope, so both endings are accepted; file text
// elsewhere cannot match because the footer must be at the end. Normal file
// text may contain the words anywhere else.
const OUTPUT_CAPPED = /\(Output capped\. Showing lines \d+-\d+\. Use offset=\d+ to continue\.\)(?:\n<\/content>)?\s*$/;

function contentText(result) {
  const parts = [];
  for (const block of Array.isArray(result?.content) ? result.content : []) {
    if (typeof block?.text === 'string') parts.push(block.text);
    else if (typeof block?.content?.text === 'string') parts.push(block.content.text);
  }
  return parts.join('\n');
}

function snapshotWindow(value) {
  if (!value || typeof value !== 'object' || !Array.isArray(value.lines)) return null;
  return {
    path: typeof value.path === 'string' ? value.path : null,
    offset: value.offset,
    totalLines: value.totalLines,
    lines: value.lines.map((line) => ({ number: line?.number, text: line?.text })),
  };
}

function sameReadWindow(left, right) {
  if (!left || !right || typeof left !== 'object' || typeof right !== 'object') return false;
  if (left.path !== right.path || left.offset !== right.offset || left.totalLines !== right.totalLines) return false;
  if (!Array.isArray(left.lines) || !Array.isArray(right.lines) || left.lines.length !== right.lines.length) return false;
  for (let index = 0; index < left.lines.length; index += 1) {
    if (left.lines[index]?.number !== right.lines[index]?.number || left.lines[index]?.text !== right.lines[index]?.text) return false;
  }
  return true;
}

return { name: 'complete-capped-read', inject: ['tools', 'fs'], apply(ctx) {
  // A pre-execute freshness token proves the file did not change between the
  // host's read and this policy's re-read. The host read result does not expose
  // a version, so without this snapshot the tail cannot be attributed to the
  // same file version.
  const versions = new Map();
  ctx.on('tools/pre-execute', async (exec, next) => {
    try {
      if (exec?.name === 'read' && typeof exec.callId === 'string'
        && typeof exec.arguments?.file_path === 'string') {
        const target = await ctx.fs.resolve(exec.arguments.file_path, {
          cwd: exec.agent?.session?.header?.cwd,
          signal: exec.signal,
        });
        const info = await ctx.fs.stat(target, exec.signal);
        if (info?.type === 'file' && typeof info.version === 'string') {
          const limit = Number(exec.arguments?.limit);
          const offset = Number(exec.arguments?.offset);
          versions.set(exec.callId, {
            target,
            version: info.version,
            limit: Number.isInteger(limit) && limit > 0 ? limit : null,
            offset: Number.isInteger(offset) && offset > 0 ? offset : null,
          });
          while (versions.size > 32) versions.delete(versions.keys().next().value);
        }
      }
    } catch { /* no snapshot means the post-execute hook declines */ }
    return next();
  });
  ctx.on('tools/post-execute', async (exec, result, next) => {
    // Non-read calls take the original chain untouched, before any snapshot or
    // argument coercion can throw.
    if (exec?.name !== 'read') return next();
    // Snapshot before awaiting downstream hooks: they may mutate result.content
    // or result.value in place. If the snapshot itself cannot be taken, keep the
    // original chain running.
    let originalContent;
    let originalContentJson;
    let originalValue;
    let originalWindow;
    let effectiveLimitSnapshot;
    try {
      originalContent = contentText(result);
      originalContentJson = JSON.stringify(result?.content ?? null);
      originalValue = result?.value;
      originalWindow = snapshotWindow(originalValue);
      effectiveLimitSnapshot = Number(exec?.arguments?.limit);
    } catch {
      return next();
    }
    const decision = await next();
    const callId = typeof exec?.callId === 'string' ? exec.callId : null;
    try {
      if (!decision || decision.kind !== 'accept') return decision;
      // A downstream hook may replace or mutate the model-visible content.
      if (contentText(result) !== originalContent) return decision;
      // A downstream decision that owns or inherits the content property (even
      // as undefined) must be returned as-is; the official postExecute rejects a
      // decision with both content and a rebuilt value.
      if (decision && 'content' in decision) return decision;
      if (JSON.stringify(result?.content ?? null) !== originalContentJson) return decision;
      if (originalWindow) {
        const currentWindow = snapshotWindow(result?.value);
        if (!currentWindow || !sameReadWindow(currentWindow, originalWindow)) return decision;
      }
      const text = originalContent;
      const footer = text.length > 0 && OUTPUT_CAPPED.test(text.length > 8192 ? text.slice(-8192) : text);
      if (!originalWindow) return decision;
      const base = decision.value === undefined ? originalValue : decision.value;
      if (!base || typeof base !== 'object' || !Array.isArray(base.lines) || typeof base.path !== 'string') return decision;
      // A downstream post-execute hook may have rewritten the window. The cap
      // signal belongs to the original host result; if the final value is a
      // different window, keep the downstream result untouched.
      if (decision.value !== undefined && originalWindow && !sameReadWindow(decision.value, originalWindow)) return decision;
      const total = base.totalLines;
      const end = base.lines.at(-1)?.number ?? (Number.isInteger(base.offset) ? base.offset - 1 : 0);
      if (!Number.isInteger(total) || !Number.isInteger(end) || end < 0 || end >= total) return decision;
      // The Trial's functional check invokes `ctx.tools.execute` directly, and
      // on that path the waterfall can receive a result without rendered
      // content. A window that stops before the requested line count and EOF
      // can only have stopped at the byte cap. The official read default is
      // 2000 lines; a deployment that configured a smaller default is not
      // distinguished here, so this path never widens more than the bounded
      // tail below (and the footer remains the precise signal elsewhere).
      const pre = callId === null ? undefined : versions.get(callId);
      if (!pre || typeof pre.version !== 'string') return decision;
      const requestedLimit = pre.limit;
      const hasExplicitLimit = Number.isInteger(requestedLimit) && requestedLimit > 0;
      const snapshotOffset = Number.isInteger(pre.offset) && pre.offset > 0 ? pre.offset : 1;
      if (Number.isInteger(base.offset) && base.offset !== snapshotOffset) return decision;
      const effectiveLimit = effectiveLimitSnapshot;
      const effectiveValid = Number.isInteger(effectiveLimit) && effectiveLimit > 0 ? effectiveLimit : null;
      if (effectiveValid === null) return decision;
      const windowLimit = Math.min(requestedLimit, effectiveValid);
      // Only the no-rendered-content path may fall back to structure, and only
      // when the caller declared an explicit limit: otherwise a deployment's
      // smaller default line window would look like a byte cap. When content is
      // present its footer is the precise signal and an ordinary "Showing lines
      // …" footer must not be widened.
      const structuralByteCap = text.length === 0 && hasExplicitLimit && base.lines.length < windowLimit;
      if (!footer && !structuralByteCap) return decision;
      // The footer only says where this byte-capped window ended; it does not
      // reveal a deployment's configured line window (`readLimit`). Without an
      // explicit caller limit there is no provable boundary, so keep the
      // original result instead of widening it to EOF or to a guessed default.
      if (!hasExplicitLimit) return decision;
      // Never read past the window the caller asked for: an explicit `limit`
      // is a request boundary even when the byte cap stopped the first window
      // early.
      const offset = snapshotOffset;
      const windowEnd = Math.min(total, offset - 1 + windowLimit);
      const missing = windowEnd - end;
      if (missing < 1 || missing > MAX_TAIL_LINES) return decision;
      const prePath = typeof pre.target === 'string' ? pre.target : pre.target?.displayPath;
      if (typeof prePath === 'string' && base.path !== prePath) return decision;
      const target = pre.target;
      const info = await ctx.fs.stat(target, exec.signal);
      if (!info || info.type !== 'file' || info.version !== pre.version
        || !Number.isInteger(info.size) || info.size > MAX_FILE_BYTES) return decision;
      const content = await ctx.fs.readText(target, exec.signal);
      // Reading is only safe while the freshness token is unchanged. A write
      // between the host read and this re-read, or during the re-read, must
      // keep the original result.
      const after = await ctx.fs.stat(target, exec.signal);
      if (!after || after.type !== 'file' || after.version !== pre.version) return decision;
      // Revalidate after the last await: the hook may have mutated content or
      // the value while the file checks were pending. Only then append
      // synchronously.
      if (contentText(result) !== originalContent) return decision;
      if (JSON.stringify(result?.content ?? null) !== originalContentJson) return decision;
      if (originalWindow) {
        const currentWindow = snapshotWindow(result?.value);
        if (!currentWindow || !sameReadWindow(currentWindow, originalWindow)) return decision;
        if (decision.value !== undefined && !sameReadWindow(decision.value, originalWindow)) return decision;
      }
      const all = content.split('\n').map((line) => line.endsWith('\r') ? line.slice(0, -1) : line);
      // The official line counter does not count the empty segment after a
      // trailing newline; drop only that one, never a real empty last line.
      if (all.length > 0 && all.at(-1) === '' && content.endsWith('\n')) all.pop();
      // The tail must come from the same snapshot as the window the host
      // returned. Re-reading is only safe when every returned line (and the
      // total line count) still matches; otherwise keep the original result.
      if (all.length !== total) return decision;
      for (const line of base.lines) {
        if (!Number.isInteger(line?.number) || typeof line?.text !== 'string') continue;
        if (all[line.number - 1] !== line.text) return decision;
      }
      const tail = [];
      let bytes = 0;
      const maxOriginalLine = base.lines.reduce((max, line) => {
        if (typeof line?.text !== 'string') return max;
        const truncated = /\.\.\. \(line truncated to (\d+) chars\)$/u.exec(line.text);
        if (truncated) {
          // The suffix proves the host line width, not the marker's length.
          return Math.max(max, line.text.slice(0, truncated.index).length);
        }
        return Math.max(max, line.text.length);
      }, 0);
      for (let number = end + 1; number <= windowEnd; number += 1) {
        const value = all[number - 1];
        if (typeof value !== 'string' || value.length > DEFAULT_LINE_CHARS) return decision;
        // Without a proven host per-line cap, a tail line longer than every
        // returned line could bypass a configured smaller readMaxLineLength.
        if (value.length > maxOriginalLine) return decision;
        bytes += encoder.encode(value).length + 1;
        if (bytes > MAX_TAIL_BYTES) return decision;
        tail.push({ number, text: value });
      }
      if (tail.length === 0) return decision;
      return { ...decision, value: { ...base, lines: [...base.lines, ...tail] } };
    } catch {
      return decision;
    } finally {
      if (callId !== null) versions.delete(callId);
    }
  });
} };
