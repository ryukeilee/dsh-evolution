  "observations": [
    {
      "id": "shipped-release-docs-are-frozen-at-the-pin",
      "observed": "README.md, CHANGELOG.md, COMPATIBILITY.md and RELEASE.md are shipped files, so they were written at pin time; RELEASE.md still calls rc.7 an unpublished local candidate and points the public entry at rc.6.",
      "whyNotFixed": "editing them after publication would change the shipped content digest and break the pin (pack:check, test/release-pin.test.mjs, release:verify). The tag and the published bytes may not be rewritten for a documentation fix.",
      "mitigation": "the post-publication record lives outside the package: the GitHub release body carries the verification summary, docs/evidence/memory-hash-investigation.md carries the release close-out, and this file is the authoritative audit. The next version pin updates RELEASE.md, as rc.7 did for rc.6."
    },
    {
      "id": "memory-file-bytes-change-on-reinstall",
      "observed": "memoryShaBeforeUninstall != memoryShaAfterReinstall in every acceptance run, while entry counts stay equal and the flow asserts existingMemoryRetained: true.",
      "scope": "present in all 22 historical acceptance evidence files in docs/evidence (rc.2-era through rc.6), so it is not introduced by rc.6.",
      "resolution": "investigated in rc.7 (docs/evidence/memory-hash-investigation.md): the reinstall itself writes nothing, and re-running the core flow updates count, lastSeenAt, evidence.at and result.rollback.at inside the same signature — a real, correct state change, not corruption. The investigation did surface and fix a separate class of real defects: a corrupted failure-memory record (nested too deep, numbers JSON cannot represent, precision loss on parse, duplicate keys, invalid UTF-8, missing identity, undefined/__proto__ keys) could be silently merged or silently rewritten by doctor or the runtime."
    },
    {
      "id": "first-doctor-degraded-is-expected",
      "observed": "the doctor-cli step records status degraded / exit 1 with verified: true and blocked: 0, because the Evolution data root is created on first run.",
      "scope": "documented expectation (RELEASE.md section 4.1); doctor-final is healthy in every run."
    },
    {
      "id": "post-publish-acceptance-first-attempt-hit-a-cold-pnpm-store",
      "observed": "the first post-publish alpha.1 attempt ran with an isolated HOME/XDG cache, so pnpm had to download the whole host tree from scratch; two platform binaries (@deepseek-ai/libreoffice-kit-darwin-arm64, @img/sharp-libvips-darwin-arm64) failed to fetch and the run stopped at host-install before installing the bundle. No bundle or host step had run.",
      "notAProductFailure": "the same anonymous bytes then passed 21/21 on the same host in the same session using the default store (warm, as in the pre-publish runs), and the pre-publish runs on both hosts passed with the same artifact.",
      "mitigation": "the recorded post-publish evidence is the successful run; the failed attempt is disclosed here rather than hidden. No retry-loop was added to the acceptance script for this."
    }
  ],
  "remainingRisksAndUnverified": [
    {
      "id": "pinned-bytes-are-human-pinned",
      "source": "RELEASE.md section 6 item 1",
      "statement": "发布字节由仓库固定的 release/ 决定，不由 CI 重建；只有同时改对 tarball 与 manifest 才可能漂移，且 pack:check / release:verify / test/release-pin.test.mjs 都会失败。"
    },
    {
      "id": "rc1-tag-artifact-mismatch",
      "source": "RELEASE.md section 6 item 2",
      "statement": "v0.2.0-rc.1 的 tag 与同名 Release 已发布字节不一致；加固后的 workflow 会明确失败，本次未移动 tag 或覆盖附件。"
    },
    {
      "id": "guard-is-heuristic",
      "source": "RELEASE.md section 6 item 3",
      "statement": "执行守卫仍是启发式策略检查，不是 shell/JavaScript 安全沙箱；promotion 执行的宿主代码是合作式执行，需要可信审批。"
    },
    {
      "id": "manual-bundle-fiber-dispose-uncovered",
      "source": "RELEASE.md section 6 item 4",
      "statement": "验收覆盖不到手工 dispose 底层 bundle Fiber 的路径，该路径不作为用户关闭流程。"
    },
    {
      "id": "domain-evaluator-advisory",
      "source": "RELEASE.md section 6 item 5",
      "statement": "promotion 的领域 evaluator 仍是 advisory；promotionGates 是生产权威，未接入独立生产 baseline/test 指标。"
    },
    {
      "id": "continuous-governance-not-wired",
      "source": "RELEASE.md section 6 item 6",
      "statement": "continuous/ 与 governance/ 领域模块未接入 orchestrator 实时循环，只有单测覆盖。"
    },
    {
      "id": "internal-host-interfaces",
      "source": "RELEASE.md section 6 item 7",
      "statement": "仍依赖内部/未文档化宿主接口（ctx.events._hooks、ctx.reflect._getImpl()、EntryTree.resolve、Entry.fiber/options/disabled）；升级 DSH 必须重跑完整验收。"
    },
    {
      "id": "trial-drift-recovery-refuses",
      "source": "RELEASE.md section 6 item 8",
      "statement": "Trial 期间持续存在的外部漂移仍拒绝恢复；签名只比较前后可观察清单，不能记录已自行恢复的瞬态漂移。"
    },
    {
      "id": "event-key-no-rotation",
      "source": "RELEASE.md section 6 item 9",
      "statement": "event-bridge.key 无轮换/吊销流程，禁用与卸载都不会删除。"
    },
    {
      "id": "no-npm-signing-sbom",
      "source": "RELEASE.md section 6 item 10",
      "statement": "未做 npm 发布、代码签名 / provenance（SLSA）或 SBOM。"
    },
    {
      "id": "alpha-dist-tag-moves",
      "source": "RELEASE.md section 6 item 11",
      "statement": "0.2.1-alpha.1 的 npm dist-tag 会移动；本仓库声明与验收的是该精确版本号。"
    },
    {
      "id": "metric-ids-are-not-credentials",
      "source": "RELEASE.md section 6 item 12",
      "statement": "指标 ID 不是授权凭证；兜底 ID 用 crypto.randomUUID()，但调用方仍可显式提供 ID。"
    },
    {
      "id": "failure-memory-last-writer-wins-no-fsync",
      "source": "RELEASE.md section 6 item 13",
      "statement": "file 后端的失败记忆仍是 last-writer-wins，save() 不做 fsync：同一数据根下两个 host 实例同时 archive() 时后写者覆盖先写者的快照，断电可能丢失最后一次 record()。这是有界、advisory 的失败记忆，本次不引入锁或 fsync。缺少 signature 的旧记录只能按整条内容去重，不参与模式匹配。"
    },
    {
      "id": "shipped-docs-frozen-at-pin",
      "source": "this audit, observation shipped-release-docs-are-frozen-at-the-pin",
      "statement": "包内 README/CHANGELOG/COMPATIBILITY/RELEASE 随固定字节冻结，rc.7 的“尚未发布”表述在发布后过时；权威记录在包外，下一个版本的 pin commit 写回 RELEASE.md。"
    },
    {
      "id": "verification-platform-coverage",
      "source": "this audit",
      "statement": "本轮本地全量测试在 darwin-arm64 的 Node 22.19.0 / 24.21.0 / 26.11.1 执行；Linux 上的真实宿主验收来自 CI（Node 22.19.0）；发布后宿主验收在 darwin-arm64 上使用匿名下载字节。未做长期生产负载、独立生产指标采集、Windows 验收或供应链签名。"
    }
  ],
