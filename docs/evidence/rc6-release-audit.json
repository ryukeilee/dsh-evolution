  "observations": [
    {
      "id": "shipped-release-docs-are-frozen-at-the-pin",
      "observed": "README.md, CHANGELOG.md, COMPATIBILITY.md and RELEASE.md are shipped files, so they were written at pin time and still describe rc.6 as an unpublished local candidate.",
      "why-not-fixed": "editing them after publication would change the shipped content digest and break the pin (pack:check, test/release-pin.test.mjs, release:verify). The tag and the published bytes may not be rewritten for a documentation fix.",
      "mitigation": "the post-publication record lives outside the package: the GitHub release body carries the verification summary, docs/performance/redundant-work.md carries the release close-out, and this file is the authoritative audit. The next version pin updates RELEASE.md, as rc.6 did for rc.5."
    },
    {
      "id": "memory-file-bytes-change-on-reinstall",
      "observed": "memoryShaBeforeUninstall != memoryShaAfterReinstall in every acceptance run, while entry counts stay equal and the flow asserts existingMemoryRetained: true.",
      "scope": "present in all 22 historical acceptance evidence files in docs/evidence (rc.2-era through rc.6), so it is not introduced by rc.6.",
      "notInvestigated": "the acceptance asserts entry retention, not byte equality, for the uninstall/reinstall path; the byte-level cause was not investigated this round."
    },
    {
      "id": "first-doctor-degraded-is-expected",
      "observed": "the doctor-cli step records status degraded / exit 1 with verified: true and blocked: 0, because the Evolution data root is created on first run.",
      "scope": "documented expectation (RELEASE.md section 4.1); doctor-final is healthy in every run."
    }
  ],
