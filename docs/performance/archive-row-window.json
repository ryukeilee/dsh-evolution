    },
    "process": "one side per process; NODE_OPTIONS=--max-old-space-size=4096; cache mode uses --expose-gc",
    "cacheMode": "real EvolutionMemory over a seeded archive tree (75% sealed segments, 25% active file); one knowledge-bearing recordObservation populates both collections; global gc twice before each reading; one entry dropped at a time for the attribution",
