+/**
+ * Count the records the plan hands back and take the torn trailing line, without
+ * materializing the whole log as a decoded string.
+ *
+ * `line.trim() !== ''` is a string predicate, so each complete segment is decoded
+ * once here and discarded. That copy is bounded by one line and the pass that
+ * follows decodes each line again only when it processes it; the released
+ * implementation decoded the complete log and kept it, plus one string object per
+ * line, for the whole pass.
+ */
+function countEventLogRecords(buffer) {
+  let completeRecords = 0;
+  let start = 0;
+  for (let index = 0; index < buffer.length; index += 1) {
+    if (buffer[index] !== LINE_FEED) continue;
+    if (buffer.toString('utf8', start, index).trim() !== '') completeRecords += 1;
+    start = index + 1;
+  }
+  return { completeRecords, remainder: buffer.toString('utf8', start) };
+}
+
+/** The complete records of the retained bytes, decoded one at a time. */
+function* eventLogLines(buffer) {
+  let start = 0;
+  for (let index = 0; index < buffer.length; index += 1) {
+    if (buffer[index] !== LINE_FEED) continue;
+    yield buffer.toString('utf8', start, index);
+    start = index + 1;
+  }
+}
